// fit sin(x) on [-pi, pi] with a small relu network. the terminal gets
// the bars, regression.jsonl gets one JSON object per event:
//
//   echoc run -m . examples/regression.eco
//   tail -f regression.jsonl                  # from another shell

use ann::{Act, Adam, Dataset, Dense, FileLog, Log, MeanSquaredError, Model, Sequential, Tensor, Trainer};
use ann::cli;

array<float64> $xs = array<float64>();
array<float64> $ys = array<float64>();

for (int32 $i = 0; $i < 200; $i++) {
    float64 $x = -std::math::PI + 2.0 * std::math::PI * ($i as float64) / 199.0;
    $xs[] = $x;
    $ys[] = std::math::sin($x);
}

$data = Dataset(Tensor(column: $xs), Tensor(column: $ys));
$split = $data->split(0.2, $seed: 1);

$net = Sequential()
    ->add(Dense(1, 32, .he))
    ->add(Act(.relu))
    ->add(Dense(32, 32, .he))
    ->add(Act(.relu))
    ->add(Dense(32, 1));

$model = Model($net, $seed: 3);
$log = Log()
    ->to(cli::Console())
    ->to(FileLog('regression.jsonl'));
$log->begin('regression');
$log->model($model);

$trainer = Trainer(
    $epochs: 300,
    $batchSize: 16,
    $metric: .rmse,
    $validation: $split->holdout,
    $observer: $log->training(),
);
$trainer->fit($model, MeanSquaredError(), Adam(0.01), $split->train);

array<float64> $probe = [-2.0, -1.0, 0.0, 0.5, 1.5, 3.0];
$out = $model->predict(Tensor(column: $probe));
$table = $log->table(['x', 'sin(x)', 'network']);

foreach ($probe as $i => $x) {
    float64 $want = std::math::sin($x);
    $table->row(["{$x:.1f}", "{$want:.4f}", "{$out->data[$i]:.4f}"]);
}

$log->note('probe', $table);
$log->end('done, every epoch is in regression.jsonl');
