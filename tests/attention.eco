use ann::{Act, Conv2D, Dense, Layer, MaxPool2D, Model, Pool, Residual, SelfAttention, Sequential, Tensor};

const ATTENTION_TOLERANCE = 0.000001;

// slot s of the result is slot order[s] of $x, for every row
internal function shuffled(const Tensor& $x, const array<usize>& $order, usize $width) : Tensor
{
    Tensor $out = $x;
    usize $cols = $x->cols();

    foreach (0 .. $x->rows() as $r) {
        foreach ($order as $s => $from) {
            foreach (0 .. $width as $k) {
                $out->data[$r * $cols + $s * $width + $k] = $x->data[$r * $cols + $from * $width + $k];
            }
        }
    }

    return $out;
}

// a 6x6 picture: conv, pool to 3x3, the 9 pixels attend to each other, mean, classify
internal function visionNet() : Sequential
{
    return Sequential()
        ->add(Conv2D(1, 4, 6, 6))
        ->add(Act(.tanh))
        ->add(MaxPool2D(4, 6, 6))
        ->add(Residual(SelfAttention(9, 4, $heads: 2)))
        ->add(Pool(9, .mean))
        ->add(Dense(4, 2));
}

#[group: "attention"]
test attention_gradients_match_finite_differences
{
    Layer $single = initialized(SelfAttention(3, 4));
    assert(gradientError($single, noise(shape(2, 12), 71)) < ATTENTION_TOLERANCE);

    Layer $multi = initialized(SelfAttention(4, 6, $heads: 3));
    assert(gradientError($multi, noise(shape(2, 24), 72)) < ATTENTION_TOLERANCE);

    // every value of a slot its own head
    Layer $narrow = initialized(SelfAttention(3, 2, $heads: 2));
    assert(gradientError($narrow, noise(shape(3, 6), 73)) < ATTENTION_TOLERANCE);
}

#[group: "attention"]
test attention_keeps_the_shape
{
    $layer = SelfAttention(5, 8, $heads: 2);
    assert($layer->outputs() == 40);
    assert($layer->params()->count() == 8);

    initialized($layer);
    $out = $layer->forward(noise(shape(3, 40), 74), .infer);
    assert($out->rows() == 3 && $out->cols() == 40);
}

#[group: "attention"]
test attention_with_equal_scores_takes_the_mean
{
    // no query projection: every score is zero, so every slot gets the mean value
    $layer = SelfAttention(3, 2);

    for (usize $d = 0; $d < 2; $d++) {
        $layer->value->value->data[$d * 2 + $d] = 1.0;
        $layer->output->value->data[$d * 2 + $d] = 1.0;
        $layer->key->value->data[$d * 2 + $d] = 3.0;
    }

    array<float64> $x = [1.0, 10.0, 2.0, 20.0, 6.0, 60.0];
    array<float64> $mean = [3.0, 30.0, 3.0, 30.0, 3.0, 30.0];
    array<usize> $s = [1, 6];
    assert(identical($layer->forward(Tensor($s, $x), .infer), Tensor($s, $mean), 0.000000000001));
}

#[group: "attention"]
test attention_permuting_slots_permutes_the_output
{
    Layer $layer = initialized(SelfAttention(4, 6, $heads: 2));
    $x = noise(shape(3, 24), 75);
    array<usize> $order = [2, 0, 3, 1];
    $out = $layer->forward($x, .infer);
    $moved = $layer->forward(shuffled($x, $order, 6), .infer);
    assert(identical($moved, shuffled($out, $order, 6), 0.000000000001));
}

#[group: "attention"]
#[tests: expects death]
test attention_refuses_heads_that_do_not_split_the_width
{
    SelfAttention(3, 6, $heads: 4);
}

#[group: "attention"]
test vision_network_gradients_match_finite_differences
{
    Layer $net = initialized(visionNet());
    assert(gradientError($net, noise(shape(2, 36), 76)) < ATTENTION_TOLERANCE);
}

#[group: "attention"]
test vision_network_round_trips_through_a_file
{
    $dir = std::env::tmp();
    $path = "{$dir}/libann-test-vision.ann";
    $model = Model(visionNet(), $seed: 6);

    guard $model->save($path) else ($e) {
        assert(false, 'save failed');
        return;
    }

    Model $loaded = guard Model::load($path) else ($e) {
        std::fs::remove($path);
        assert(false, 'load failed');
        return;
    }

    std::fs::remove($path);
    $x = noise(shape(4, 36), 77);
    assert(identical($model->predict($x), $loaded->predict($x)));
    assert($loaded->summary() == $model->summary());
    assert($loaded->encode() == $model->encode());
}

// relation of query slot i to key slot j on a line of slots: the signed distance, shifted to start at 0
internal function line(usize $slots) : array<usize>
{
    array<usize> $out = array<usize>();

    foreach (0 .. $slots as $i) {
        foreach (0 .. $slots as $j) {
            $out[] = $j + $slots - 1 - $i;
        }
    }

    return $out;
}

internal function related(usize $slots, usize $width, usize $heads) : SelfAttention
{
    $layer = SelfAttention($slots, $width, $heads, line($slots), 2 * $slots - 1);
    initialized($layer);
    Tensor $bias = noise(shape($heads, 2 * $slots - 1), 78);

    foreach (0 .. $bias->data->count() as $i) {
        $layer->bias->value->data[$i] = $bias->data[$i];
    }

    return $layer;
}

#[group: "attention"]
test relative_attention_gradients_match_finite_differences
{
    Layer $one = related(3, 4, 1);
    assert(gradientError($one, noise(shape(2, 12), 79)) < ATTENTION_TOLERANCE);

    Layer $heads = related(4, 6, 3);
    assert(gradientError($heads, noise(shape(2, 24), 80)) < ATTENTION_TOLERANCE);
}

#[group: "attention"]
test a_strong_bias_attends_to_the_named_relation
{
    $layer = SelfAttention(3, 2, 1, line(3), 5);
    initialized($layer);
    // relation 3 is "the next slot"; nothing else gets a say
    $layer->bias->value->data[3] = 50.0;
    assert($layer->params()->count() == 9);
    assert($layer->kind() == 'relattention');

    $x = noise(shape(1, 6), 81);
    $out = $layer->forward($x, .infer);
    assert($out->rows() == 1 && $out->cols() == 6);

    // slot 0 reads slot 1 alone: its own input no longer matters, slot 1's does
    Tensor $own = $x;
    $own->data[0] = $own->data[0] + 1.0;
    $own->data[1] = $own->data[1] - 1.0;
    Tensor $moved = $layer->forward($own, .infer);
    assert(std::math::abs($moved->data[0] - $out->data[0]) < 0.000001);

    Tensor $next = $x;
    $next->data[2] = $next->data[2] + 1.0;
    Tensor $changed = $layer->forward($next, .infer);
    assert(std::math::abs($changed->data[0] - $out->data[0]) > 0.000001 || std::math::abs($changed->data[1] - $out->data[1]) > 0.000001);
}

#[group: "attention"]
test relative_attention_round_trips_through_a_file
{
    $dir = std::env::tmp();
    $path = "{$dir}/libann-test-relattention.ann";
    $net = Sequential()->add(Residual(related(4, 6, 2)))->add(Pool(4, .mean))->add(Dense(6, 1));
    $model = Model($net, $seed: 7);

    guard $model->save($path) else ($e) {
        assert(false, 'save failed');
        return;
    }

    Model $loaded = guard Model::load($path) else ($e) {
        std::fs::remove($path);
        assert(false, 'load failed');
        return;
    }

    std::fs::remove($path);
    $x = noise(shape(3, 24), 82);
    assert(identical($model->predict($x), $loaded->predict($x)));
    assert($loaded->encode() == $model->encode());
}
